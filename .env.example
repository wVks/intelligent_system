# Local demo: real MCP, deterministic answers, no paid LLM requests.
STUDYNAV_MODE=offline
STUDYNAV_DB_PATH=var/study.db
# Optional: defaults to uploads/ beside the SQLite database.
# STUDYNAV_UPLOADS_PATH=var/uploads
STUDYNAV_MAX_TOOL_CALLS=6
STUDYNAV_REQUEST_TIMEOUT=45
STUDYNAV_TOOL_TIMEOUT=10
STUDYNAV_PROVIDER_TIMEOUT=20
# Upper bounds per model response; lower them for a limited live evaluation.
STUDYNAV_CHAT_MAX_TOKENS=1000
STUDYNAV_ANALYSIS_MAX_TOKENS=3000
STUDYNAV_RATE_LIMIT=10
# Optional shared live API budget, disabled when unset. Set an explicit RUB
# amount in (0, 150] only for supported Yandex models; the persistent ledger is never reset.
# STUDYNAV_LIVE_BUDGET_RUB=
# STUDYNAV_LIVE_BUDGET_PATH=var/live-budget.json
HOST=127.0.0.1
PORT=8000

# Live requires a Chat Completions API with function tools and max_tokens support.
# Set STUDYNAV_MODE=live only after configuring all three values.
# Configure the provider URL and model when access is available.
# Yandex: LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Yandex: LLM_MODEL=gpt://<your_folder_id>/yandexgpt-5.1/latest
# The adapter derives OpenAI-Project from this URI and uses API-key authentication.
LLM_BASE_URL=
LLM_MODEL=
# Optional explicit analysis role; empty reuses LLM_MODEL. No automatic switching.
# LLM_ANALYSIS_MODEL=gpt://<your_folder_id>/aliceai-llm-flash
LLM_ANALYSIS_MODEL=
# API KEY PLACEHOLDER: add the real key later in an ignored local .env or server env.
# Keep this value empty here; a literal placeholder would count as a configured key.
LLM_API_KEY=
